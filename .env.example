# VAPT Platform — Environment Variables
# Copy to .env and fill values before running `docker compose up -d --build`.

# ─── API Security ───────────────────────────────────────────────────
# Set a strong secret to protect the API. Leave empty for dev/local-only use.
# All /api/* endpoints require X-API-Key: <value> header when set.
VAPT_API_KEY=
VAPT_APPSEC_GIT_HOSTS=github.com,gitlab.com
VAPT_APPSEC_MAX_REPO_MB=512

# ─── Database ───────────────────────────────────────────────────────
VAPT_DATABASE_URL=sqlite:////app/data/vapt.db

# ─── Task Queue ─────────────────────────────────────────────────────
# Redis is started automatically by docker-compose — no change needed.
# Override only if using an external Redis.
# REDIS_URL=redis://redis:6379/0

# Worker scaling: how many parallel tool containers each worker can run.
WORKER_MAX_JOBS=15
# Number of worker replicas (docker compose up --scale worker=N also works).
WORKER_REPLICAS=2

# ─── LLM providers ──────────────────────────────────────────────────
# Set these three to choose the primary AI provider without editing config.yaml.
VAPT_LLM_PROVIDER=openai
VAPT_LLM_MODEL=gpt-4o
VAPT_LLM_API_KEY_ENV=OPENAI_API_KEY
# For local/OpenAI-compatible models, set provider=openai_compat and point at
# the host from inside Docker, e.g. http://host.docker.internal:1234
VAPT_LLM_BASE_URL=
VAPT_LLM_ENABLED=false
VAPT_LLM_ALLOW_FALLBACKS=false
# Metadata logs show provider/model, prompt hash/size, duration and failures.
# Use "redacted" temporarily to include bounded prompt/response previews.
VAPT_LLM_TRACE=metadata
# Scanner-emitted CVEs are always NVD-verified. Keep per-finding LLM CVE
# proposals disabled to avoid unnecessary API fan-out and hallucinations.
VAPT_CVE_LLM_PROPOSALS=false
OPENAI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ─── Vulnerability intelligence ─────────────────────────────────────
NVD_API_KEY=

# ─── Scanner budgets ────────────────────────────────────────────────
VAPT_NUCLEI_MAX_TARGETS=8
VAPT_NUCLEI_BATCH_TIMEOUT=180
VAPT_NUCLEI_TOTAL_BUDGET=240

# ─── OSINT / internet exposure ──────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=

# ─── CMS scanning ──────────────────────────────────────────────────────
# WPScan API token enables CVE lookups for WordPress plugins/themes.
# Without it, WPScan still enumerates installed components, users, and
# interesting files (readme.html, xmlrpc.php, etc.) but can't report CVEs.
# Free token: https://wpscan.com/api (25 API requests/day on free tier)
WPSCAN_API_TOKEN=
