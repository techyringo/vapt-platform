# VAPT Platform — Environment Variables
# Copy to .env and fill values before running `docker compose up -d --build`.

# ─── API Security ───────────────────────────────────────────────────
# Set a strong secret to protect the API. Leave empty for dev/local-only use.
# All /api/* endpoints require X-API-Key: <value> header when set.
VAPT_API_KEY=
VAPT_APPSEC_GIT_HOSTS=github.com,gitlab.com
VAPT_APPSEC_MAX_REPO_MB=512
# Provider verification makes outbound authentication checks. Keep disabled
# unless the engagement policy explicitly permits validating detected secrets.
VAPT_SECRET_ACTIVE_VERIFICATION=false

# ─── Database ───────────────────────────────────────────────────────
VAPT_DATABASE_URL=sqlite:////app/data/vapt.db

# ─── Task Queue ─────────────────────────────────────────────────────
# Redis is started automatically by docker-compose — no change needed.
# Override only if using an external Redis.
# REDIS_URL=redis://redis:6379/0

# Worker scaling: how many parallel tool containers each worker can run.
WORKER_MAX_JOBS=2
# Safety ceiling protects analyst laptops even when an older .env still asks
# for more jobs. Raise both values only after measuring host memory headroom.
WORKER_MAX_JOBS_HARD_LIMIT=2
# Number of worker replicas (docker compose up --scale worker=N also works).
WORKER_REPLICAS=1
# Per-process scanner ceiling. Effective concurrency is also bounded by
# WORKER_MAX_JOBS; keep both conservative on analyst laptops.
MAX_CONCURRENT_CONTAINERS=2

# ─── LLM providers ──────────────────────────────────────────────────
# Set these three to choose the primary AI provider without editing config.yaml.
VAPT_LLM_PROVIDER=openai
VAPT_LLM_MODEL=gpt-4o
VAPT_LLM_API_KEY_ENV=OPENAI_API_KEY
# When API_KEY_ENV is named and populated, its value is authoritative over a
# key previously stored from Settings. After changing .env, `docker compose
# restart` is not enough: recreate API + workers with
# `docker compose up -d --force-recreate backend worker`.
# For local/OpenAI-compatible models, set provider=openai_compat and point at
# the host from inside Docker, e.g. http://host.docker.internal:1234
VAPT_LLM_BASE_URL=
VAPT_LLM_ENABLED=false
VAPT_LLM_ALLOW_FALLBACKS=false
# Metadata logs show provider/model, prompt hash/size, duration and failures.
# Use "redacted" temporarily to include bounded prompt/response previews.
VAPT_LLM_TRACE=metadata
VAPT_LLM_REVIEW_BATCH_SIZE=8
VAPT_LLM_REMEDIATION_LIMIT=8
VAPT_ADAPTIVE_LLM_TIMEOUT=30
# Scanner-emitted CVEs are always NVD-verified. Keep per-finding LLM CVE
# proposals disabled to avoid unnecessary API fan-out and hallucinations.
VAPT_CVE_LLM_PROPOSALS=false
OPENAI_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# ─── Vulnerability intelligence ─────────────────────────────────────
NVD_API_KEY=

# ─── Scanner budgets ────────────────────────────────────────────────
VAPT_NUCLEI_MAX_TARGETS=8
VAPT_NUCLEI_BATCH_TIMEOUT=300
VAPT_NUCLEI_TOTAL_BUDGET=600
VAPT_KATANA_CRAWL_DURATION=240
VAPT_KATANA_TIMEOUT=330
VAPT_AMASS_TIMEOUT=180
VAPT_ASSETFINDER_TIMEOUT=120
VAPT_WAYBACK_TIMEOUT=90
VAPT_GAU_TIMEOUT=90
VAPT_ARJUN_TIMEOUT=180
VAPT_TOOL_LOG_MIRROR=true
VAPT_TOOL_LOG_MIRROR_MAX_CHARS=1000
# The browser is an operational console, not the raw-output archive. summary
# sends tool commands and warning/error lines only; sampled additionally sends
# at most the bounded rate below. Full output remains a downloadable artifact.
VAPT_TOOL_LOG_MODE=summary
VAPT_TOOL_LOG_MAX_LINES=80
VAPT_TOOL_LOG_MAX_PER_SECOND=4
# Full stdout/stderr is spooled to disk. Only this bounded prefix is retained
# in worker memory / Redis for parsers and immediate result handling.
VAPT_TOOL_RESULT_MAX_BYTES=2097152
VAPT_ARQ_QUEUE_GRACE=300
VAPT_ARQ_KEEP_RESULT=1800
VAPT_SEMGREP_RULESETS=p/default,p/security-audit,p/owasp-top-ten,p/secrets
# Public or engagement-reachable base URL for single-use HTTP OOB proof tokens.
# Leave blank to disable SSRF OOB validation. Example for a local lab behind
# the reverse proxy: http://host.docker.internal
VAPT_OOB_BASE_URL=

# ─── OSINT / internet exposure ──────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=

# ─── CMS scanning ──────────────────────────────────────────────────────
# WPScan API token enables CVE lookups for WordPress plugins/themes.
# Without it, WPScan still enumerates installed components, users, and
# interesting files (readme.html, xmlrpc.php, etc.) but can't report CVEs.
# Free token: https://wpscan.com/api (25 API requests/day on free tier)
WPSCAN_API_TOKEN=
